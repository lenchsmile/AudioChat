{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 4,
    "minor": 2,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "clang-debug",
      "displayName": "Clang Debug",
      "description": "Debug build with Clang compiler",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/out/build/clang-debug",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "clang",
        "CMAKE_CXX_COMPILER": "clang++",
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
      "name": "clang-release",
      "displayName": "Clang Release",
      "description": "Release build with Clang compiler",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/out/build/clang-release",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "clang",
        "CMAKE_CXX_COMPILER": "clang++",
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
      "name": "msvc-debug",
      "displayName": "MSVC Debug",
      "description": "Debug build with MSVC compiler",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/out/build/msvc-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
      "name": "msvc-release",
      "displayName": "MSVC Release",
      "description": "Release build with MSVC compiler",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/out/build/msvc-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
      "name": "msvc-aec-release",
      "displayName": "MSVC Release with required WebRTC AEC",
      "description": "Production AEC build using the vcpkg aec manifest feature",
      "generator": "Visual Studio 18 2026",
      "architecture": {
        "value": "x64",
        "strategy": "external"
      },
      "binaryDir": "${sourceDir}/out/build/msvc-aec-release",
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "VCPKG_MANIFEST_FEATURES": "aec",
        "BUILD_TESTING": "ON",
        "REQUIRE_AEC": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "clang-debug",
      "configurePreset": "clang-debug",
      "displayName": "Clang Debug Build",
      "targets": ["AudioChat", "AudioChatTests"]
    },
    {
      "name": "clang-release",
      "configurePreset": "clang-release",
      "displayName": "Clang Release Build",
      "targets": ["AudioChat", "AudioChatTests"]
    },
    {
      "name": "msvc-debug",
      "configurePreset": "msvc-debug",
      "displayName": "MSVC Debug Build",
      "targets": ["AudioChat", "AudioChatTests"]
    },
    {
      "name": "msvc-release",
      "configurePreset": "msvc-release",
      "displayName": "MSVC Release Build",
      "targets": ["AudioChat", "AudioChatTests"]
    },
    {
      "name": "msvc-aec-release",
      "configurePreset": "msvc-aec-release",
      "displayName": "MSVC AEC Release Build",
      "targets": ["AudioChat", "AudioChatTests"]
    }
  ],
  "testPresets": [
    {
      "name": "clang-debug",
      "configurePreset": "clang-debug",
      "displayName": "Clang Debug Tests",
      "execution": {
        "noTestsAction": "error",
        "stopOnFailure": true
      }
    },
    {
      "name": "clang-release",
      "configurePreset": "clang-release",
      "displayName": "Clang Release Tests",
      "execution": {
        "noTestsAction": "error",
        "stopOnFailure": true
      }
    },
    {
      "name": "msvc-debug",
      "configurePreset": "msvc-debug",
      "displayName": "MSVC Debug Tests",
      "execution": {
        "noTestsAction": "error",
        "stopOnFailure": true
      }
    },
    {
      "name": "msvc-release",
      "configurePreset": "msvc-release",
      "displayName": "MSVC Release Tests",
      "execution": {
        "noTestsAction": "error",
        "stopOnFailure": true
      }
    },
    {
      "name": "msvc-aec-release",
      "configurePreset": "msvc-aec-release",
      "displayName": "MSVC AEC Release Tests",
      "execution": {
        "noTestsAction": "error",
        "stopOnFailure": true
      }
    }
  ]
}
